{
  "name": "fanout",
  "productName": "fanout",
  "version": "0.2.0",
  "description": "One window for every brand's social accounts: isolated logins, tabs per brand, and a file panel you drag uploads from.",
  "author": "thedumbstuff",
  "license": "MIT",
  "homepage": "https://thedumbstuff.page",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "electron tools/smoke.mjs",
    "icon": "electron tools/make-icon.mjs",
    "measure": "electron tools/measure-memory.mjs",
    "screenshots": "electron tools/screenshots.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "page.thedumbstuff.fanout",
    "productName": "fanout",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "build/drag.png",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "fanout-setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "fanout-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "thedumbstuff",
      "artifactName": "fanout-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://thedumbstuff.page/downloads/fanout/current/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
